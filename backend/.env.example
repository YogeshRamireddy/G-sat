# Optional if you use backend/model_bundle/ directly.
SEGMENTATION_MODEL_ROOT=/absolute/path/to/model-repo

# Optional if entrypoint is not one of:
# run_segmentation.py | inference.py | predict.py | main.py
SEGMENTATION_ENTRYPOINT=run_segmentation.py

# Optional model checkpoint path (.pth). Passed to entrypoint as --weights <path>.
SEGMENTATION_MODEL_WEIGHTS_PATH=/absolute/path/to/model_best.pth
